# =============================================
# OpenHackathonGPT — Environment Configuration
# Copy this file to .env and fill in values
# =============================================

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=                        # Leave blank to auto-select first available model

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development                   # development | production
SECRET_KEY=change-me-to-a-random-string-in-production
AUTH_API_KEY=                         # Set this to require API key for all requests (leave blank to disable auth)

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/hackathon.db

# Logging
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# Search Provider
SEARCH_PROVIDER=duckduckgo            # duckduckgo | tavily | serpapi
TAVILY_API_KEY=                       # Required only if SEARCH_PROVIDER=tavily
SERPAPI_API_KEY=                      # Required only if SEARCH_PROVIDER=serpapi

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Search Cache TTL (seconds)
SEARCH_CACHE_TTL=3600

# CORS Origins (comma-separated, * for all)
CORS_ORIGINS=*

# Agent Timeout (seconds per agent)
AGENT_TIMEOUT=120
